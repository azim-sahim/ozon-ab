# Скопируйте: cp env.example .env
# docker compose подхватит переменные из .env

# Публичный URL. Для локального Docker оставьте localhost.
# Для боя — https://ab.example.com  (Ozon качает фото отсюда)
APP_URL=http://localhost:8080
BETTER_AUTH_URL=http://localhost:8080

# Секрет сессий и шифрования ключей Ozon. Один раз: openssl rand -hex 32
# После смены ключи магазинов нужно сохранить заново.
BETTER_AUTH_SECRET=change-me-dev-only

# Защита /api/cron/tick (пусто = без проверки, только для локалки)
CRON_SECRET=

# Дополнительные origin через запятую, если заходите не с APP_URL
# AUTH_TRUSTED_ORIGINS=http://192.168.1.10:8080
